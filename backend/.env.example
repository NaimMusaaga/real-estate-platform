PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=real_estate

# Single access token for MVP — no refresh token yet (future-version concern, see Step 2 notes)
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# console = log emails to the server console (local dev default)
# mailtrap = send through a free Mailtrap sandbox inbox
EMAIL_MODE=console
MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USER=
MAILTRAP_PASS=

UPLOAD_DIR=uploads

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
